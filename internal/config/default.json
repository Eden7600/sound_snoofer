{
  "version": 1,
  "poll_ms": 1000,
  "debounce_ms": 1000,
  "verify_ms": 5000,
  "profiles": {
    "microphones": [
      "lav",
      "webcam"
    ]
  },
  "studio": {
    "asio": [
      {
        "asio_pattern": "(?i)^Universal Audio Volt$",
        "presence_pattern": "(?i)^INPUT 1/2 \\(Volt 2\\)$",
        "inputs": [
          1,
          2
        ]
      }
    ],
    "playback": [
      {
        "driver": "wdm",
        "pattern": "(?i)airpods"
      },
      {
        "driver": "wdm",
        "pattern": "(?i)steelseries.*arena"
      },
      {
        "driver": "asio",
        "pattern": "(?i)^Universal Audio Volt$"
      }
    ],
    "fallback_mic": [
      {
        "driver": "wdm",
        "pattern": "(?i)insta360.*link.*2"
      }
    ],
    "move_playback_routing": true,
    "playback_sources": [
      "virtual:1"
    ],
    "recording": {
      "computer_sources": [
        "virtual:1"
      ]
    },
    "voice": {
      "enabled": true,
      "source": "desk",
      "mode": "element",
      "monitor": "off"
    }
  }
}
